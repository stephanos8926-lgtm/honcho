# ──────────────────────────────────────────────────────────────
# Honcho Environment — RapidWebs Single-Container Deployment
# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in values. REQUIRED: OPENROUTER_API_KEY.
# Configuration reference: https://docs.honcho.dev/v3/contributing/self-hosting
#
# ⚠️  config.toml is the AUTHORITATIVE config (bind-mounted from host).
#     This .env only sets secrets/keys that config.toml references via
#     api_key_env. All other settings live in config.toml.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://honcho:honcho@127.0.0.1:5432/honcho
DB_SCHEMA=public

# ── LLM Provider (OpenRouter — Deriver, Dialectic, Summary, Dream) ────
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: override model per-agent (defaults to nvidia/nemotron-3-ultra-550b-a55b:free)
# DERIVER_MODEL_CONFIG__TRANSPORT=openai
# DERIVER_MODEL_CONFIG__MODEL=anthropic/claude-sonnet-4
# DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
# DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=google/gemini-2.5-flash
# ... etc.

# ── Embedding (RW InferenceEngine — LOCAL, OpenAI-compatible) ──────
# RW IE MUST be running on the SAME HOST at 127.0.0.1:8300
# Default model: bge-small-en-v1.5 (384-dim)
# Build/deploy with: ./deploy/setup.sh (builds RW IE image + starts container)
EMBEDDING_MODEL_CONFIG__TRANSPORT=rw_inference
EMBEDDING_MODEL_CONFIG__MODEL=bge-small-en-v1.5
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://127.0.0.1:8300/v1
EMBEDDING_VECTOR_DIMENSIONS=384

# ── Deriver (In-Process) ───────────────────────────────────────────
DERIVER_IN_PROCESS_MODE=true
DERIVER_FLUSH_ENABLED=true
DERIVER_IN_PROCESS_POLL_INTERVAL_SECONDS=0.5

# ── Memory Features ────────────────────────────────────────────────
PEER_CARD_ENABLED=true
DREAM_ENABLED=true
DREAM_ENABLED_TYPES=["omni", "card_refresh"]
SUMMARY_ENABLED=true
EMBED_MESSAGES=true

# ── Auth ───────────────────────────────────────────────────────────
AUTH_USE_AUTH=false