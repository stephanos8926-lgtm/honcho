# ──────────────────────────────────────────────────────────────
# Honcho Environment — RapidWebs Single-Container Deployment
# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in values.
# Configuration reference: https://docs.honcho.dev/v3/contributing/self-hosting

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://honcho:honcho@database:5432/honcho
DB_SCHEMA=public

# ── LLM Provider (Gemini 2.5 Flash Lite) ──────────────────────
# Default LLM for all Honcho agents (Deriver, Dialectic, Summary, Dream)
LLM_GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override per-agent models
# DERIVER_MODEL_CONFIG__TRANSPORT=gemini
# DERIVER_MODEL_CONFIG__MODEL=gemini-2.5-flash-lite
# DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=gemini
# DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=gemini-2.5-flash-lite
# DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=gemini
# DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=gemini-2.5-flash-lite
# DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=gemini
# DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=gemini-2.5-flash-lite
# DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=gemini
# DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=gemini-2.5-flash-lite

# ── Embedding (RW InferenceEngine) ─────────────────────────────
# RW IE runs on srv1 at Tailscale IP 100.75.220.1:8300
# Default model: bge-small-en-v1.5 (384-dim)
EMBEDDING_MODEL_CONFIG__TRANSPORT=rw_inference
EMBEDDING_MODEL_CONFIG__MODEL=bge-small-en-v1.5
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://100.75.220.1:8300/v1
EMBEDDING_VECTOR_DIMENSIONS=384

# ── In-Process Deriver (single-container mode) ─────────────────
DERIVER_IN_PROCESS_MODE=true
DERIVER_FLUSH_ENABLED=true
DERIVER_IN_PROCESS_POLL_INTERVAL_SECONDS=0.5

# ── Memory Features ────────────────────────────────────────────
PEER_CARD_ENABLED=true
DREAM_ENABLED=true
SUMMARY_ENABLED=true
EMBED_MESSAGES=true
